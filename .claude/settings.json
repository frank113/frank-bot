{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ollama list *)",
      "Bash(ollama ls *)",
      "Skill(populate-models-table)"
    ],
    "deny": [
        "Bash(git add *)",
        "Bash(git commit *)",
        "Bash(git rm *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  }
}